# Copy to .env (git-ignored). Docker Compose reads it; export the same values for the backend if you change them.
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/tarjepafi
DB_USERNAME=tarjepafi
DB_PASSWORD=tarjepafi

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=tarjepafi
RABBITMQ_PASSWORD=tarjepafi

# system | simulated
CLOCK_MODE=system
CORS_ALLOWED_ORIGINS=http://localhost:4781,http://localhost:4200

# Required outside the dev profile, at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION=8h
# Optional first administrator (TS01). Must be an @upc.edu.pe address.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Deployed environment only (see docs/DEPLOYMENT.md). Neon needs ?sslmode=require and the direct (non-pooler) host.
# DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
# DB_POOL_SIZE=5
# SPRING_PROFILES_ACTIVE=demo
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Broker image only (docker/rabbitmq): the restricted MQTT user the Wokwi reader uses. It is created once the backend
# has declared the tarjepafi.devices exchange. Its password is visible in the public Wokwi project: never reuse it.
# READER_USERNAME=reader-demo
# READER_PASSWORD=
